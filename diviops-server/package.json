{
  "name": "@diviops/mcp-server",
  "version": "1.6.0",
  "description": "MCP server exposing Divi 5 Visual Builder as tools for Claude",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "diviops-mcp": "dist/index.js",
    "diviops-preset": "dist/preset-cli/bin.js",
    "diviops-cross-env-preflight": "dist/cross-env-preflight/bin.js"
  },
  "files": [
    "dist/**/*",
    "!dist/**/__tests__/**",
    "templates",
    "data/verified-attrs.json",
    "data/verified-attrs-backlog.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-vendored-cross-env-preflight.mjs",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "npm run build && node --test dist/__tests__/*.test.js dist/preset-cli/__tests__/*.test.js dist/cross-env-preflight/__tests__/*.test.js",
    "test:server-security": "tsc -p tsconfig.test.json && env -u DIVIOPS_WP_CLI_ALLOW node --test dist-test/__tests__/*.test.js",
    "test:regen-skill": "node --test scripts/regen-module-formats.test.mjs",
    "prepublishOnly": "npm run build",
    "regen:skill": "node scripts/regen-module-formats.mjs"
  },
  "keywords": [
    "mcp",
    "divi",
    "wordpress",
    "claude",
    "visual-builder",
    "model-context-protocol"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rubicon/diviops.git",
    "directory": "diviops-server"
  },
  "bugs": {
    "url": "https://github.com/rubicon/diviops/issues"
  },
  "homepage": "https://github.com/rubicon/diviops/tree/main/diviops-server#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
