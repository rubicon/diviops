# Fork-owned. Upstream ships no .gitignore; see FORK.md.

# Per-issue worktrees live inside the repo and must never be committed.
worktrees/

# OS and editor junk
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Local agent scratch
.remember/
.claude/settings.local.json
# Codex review transcripts. The codex-review skill hardcodes this path (#144).
.jez/

# Node build artifacts (diviops-server)
node_modules/
dist/
dist-test/

# PHP dev-tooling deps (PHPStan + WordPress stubs, #71) -- composer.lock is
# committed and pins versions; vendor/ is installed fresh by composer.json.
vendor/

# Local codebase-memory knowledge-graph index (#211). Regenerates deterministically
# from source via index_repository, changes on every reindex, and is binary -- so
# committing it would churn reviewed diffs for no benefit a local reindex lacks.
.codebase-memory/

# Server-local MCP artifact stores (#544). Two stores resolve their root against
# process.cwd(), which is this repository whenever the server is launched from a
# checkout: diviops-server/src/page-export-ref.ts writes .diviops-tmp/page-exports/
# and diviops-server/src/cross-env-preflight/source-payload-ref.ts writes
# .diviops-tmp/cross-env-source-payloads/. Both defaults are deliberate -- the
# handle + checksum + TTL design refuses a caller-supplied destination -- so the
# containment belongs here rather than in the stores.
#
# A page export is Divi's portability schema with every image on the page inlined
# as base64: a verbatim copy of a real page from a development site. This
# repository is PUBLIC, so one reaching a commit publishes a client's page content
# under our name. Found untracked AND unignored on main, one `git add -A` away.
#
# Unanchored on purpose -- the server may be launched from the repository root or
# from diviops-server/, and an anchored rule would cover the first and silently
# miss the second. tests/test-scratch-artifacts-untracked.php fails the suite if
# the rule stops matching, if it moves to a machine-local exclude file, or if an
# artifact is ever force-added.
.diviops-tmp/

# Built by scripts/build-plugin-zip.php and attached to releases (#238).
# Not tracked: a committed binary cannot stay in sync with a version release-please bumps.
/diviops-agent.zip
/diviops-design-library.zip

# Local archive of published upstream releases (#268). The README is the guard
# and is tracked; the artifacts never are. `rubicon/diviops` is public, and
# `upstream-releases/pro/` holds a commercial plugin we neither fork nor license --
# committing one would publish a third party's source under our name.
# tests/test-upstream-releases-untracked.php fails the suite if that ever happens.
/upstream-releases/**
!/upstream-releases/README.md

# Belt for the same boundary outside that directory (#268). A Pro artifact
# extracted or copied anywhere in the tree is the same licensing incident.
diviops-agent-pro*
diviops-pro-suite-*

# Working notes are for the maintainer, not for a public repository. A session
# log was committed here once (#506) and reached two pushed branches before an
# adversarial review caught it: 71 lines of handoff, including a "Mistakes I
# made" section, in a repo whose visibility is PUBLIC. Neither PR body mentioned
# the file. These belong in .remember/ or in chat, never in the tree.
session-log.md
/.remember/
