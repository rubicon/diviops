{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "bootstrap-sha": "ccc290533b20fbdd6642a0afb2162e3fdbbbd677",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "diviops-agent",
      "exclude-paths": [
        "diviops-server"
      ],
      "extra-files": [
        {
          "type": "generic",
          "path": "plugins/diviops-agent/diviops-agent.php"
        },
        {
          "type": "generic",
          "path": "plugins/diviops-agent/readme.txt"
        },
        {
          "type": "json",
          "path": ".claude-plugin/plugin.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "diviops-server": {
      "release-type": "node",
      "package-name": "@rubicontv/diviops-mcp",
      "component": "mcp-server",
      "include-component-in-tag": true
    }
  }
}
